rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow user document and subcollections scoped by userId
    match /users/{userId} {
      allow read, write: if userId != null && userId != '';

      match /{allPaths=**} {
        allow read, write: if userId != null && userId != '';
      }
    }
  }
}
