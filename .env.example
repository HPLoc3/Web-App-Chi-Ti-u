# ==============================================================================
# QUẢN LÝ CHI TIÊU - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (for production/default) or .env.development / .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & NETWORK
# ------------------------------------------------------------------------------
# Environment: 'development' | 'production' | 'test'
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# So khớp CHÍNH XÁC theo origin (giao thức + host + port), không hỗ trợ "*".
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Số lớp proxy tin cậy phía trước app (số nguyên 0-10, sai thì dùng 1)
TRUST_PROXY_HOPS=1
# Bật TẠM THỜI (chỉ đúng chuỗi "true" chữ thường mới bật) để log req.ip và x-forwarded-for của request /api
DEBUG_CLIENT_IP=false

# Frontend API URL (Used during Vite build/client requests)
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# === [DEVELOPMENT ENVIRONMENT] ===
# Run with local Docker database on port 5433 (via docker-compose.dev.yml):
#   npm run db:dev:up
#   npm run db:dev:migrate
#   npm run db:dev:seed
DATABASE_URL="postgresql://postgres:dev_password_123@127.0.0.1:5433/hophuloc_expense_db_dev?schema=public"

# (Tùy chọn) Kết nối trực tiếp, chỉ dùng cho migrate lúc container khởi động (xem Dockerfile).
# Cần khi DATABASE_URL đi qua pooler (vd Neon "-pooler"). Để trống thì migrate dùng DATABASE_URL.
# Lưu ý: lệnh "npx prisma migrate deploy" chạy tay không đọc biến này.
DIRECT_URL=""

# CHỈ dùng khi chạy dev KHÔNG có database: đúng chuỗi "true" mới dùng dữ liệu mẫu trong bộ nhớ
# (kèm tài khoản test, mất khi khởi động lại). Luôn bị tắt khi NODE_ENV=production.
DEV_FALLBACK_STORE=false

# Credentials for docker-compose.dev.yml:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password_123
POSTGRES_DB=hophuloc_expense_db_dev

# === [PRODUCTION ENVIRONMENT (VPS Host PM2 -> Docker PostgreSQL)] ===
# When deploying to production on VPS, set in /var/www/app-chi-tieu/.env:
# NODE_ENV=production
# APP_URL=https://hophuloc.online
# VITE_API_URL=https://hophuloc.online
# DATABASE_URL="postgresql://postgres:<YOUR_SECURE_POSTGRES_PASSWORD>@127.0.0.1:5432/hophuloc_expense_db?schema=public"

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION (Mandatory)
# ------------------------------------------------------------------------------
# In development, you can use these default dev secrets:
JWT_SECRET="dev_jwt_secret_must_be_minimum_32_characters_long_for_security_12345"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_must_be_minimum_32_characters_long_12345"

# ------------------------------------------------------------------------------
# 4. THIRD-PARTY INTEGRATIONS (Optional)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 (For Google Sign-In)
# Frontend Client ID (safe for browser)
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Backend Client Secret (Private - NEVER expose to frontend or commit to git)
GOOGLE_CLIENT_SECRET=""

# Gemini AI Assistant (For natural language transaction parsing & financial advice)
GEMINI_API_KEY=""

# Resend (Gửi email quên mật khẩu). API key phải giữ bí mật, KHÔNG commit.
# Domain gửi cần được xác minh SPF/DKIM trên Resend. Để trống thì không gửi mail.
RESEND_API_KEY=""
EMAIL_FROM="Sổ Tay Chi Tiêu <no-reply@hophuloc.online>"

# Logging Level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
