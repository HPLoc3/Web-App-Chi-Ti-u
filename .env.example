# ==============================================================================
# QUẢN LÝ CHI TIÊU - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (for production/default) or .env.development / .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & NETWORK
# ------------------------------------------------------------------------------
# Environment: 'development' | 'production' | 'test'
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://hophuloc.online"

# Frontend API URL (Used during Vite build/client requests)
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# === [DEVELOPMENT ENVIRONMENT] ===
# Run with local Docker database on port 5433 (via docker-compose.dev.yml):
#   npm run db:dev:up
#   npm run db:dev:migrate
#   npm run db:dev:seed
DATABASE_URL="postgresql://postgres:dev_password_123@127.0.0.1:5433/hophuloc_expense_db_dev?schema=public"

# Credentials for docker-compose.dev.yml:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password_123
POSTGRES_DB=hophuloc_expense_db_dev

# === [PRODUCTION ENVIRONMENT (VPS Host PM2 -> Docker PostgreSQL)] ===
# When deploying to production on VPS, set in /var/www/app-chi-tieu/.env:
# NODE_ENV=production
# APP_URL=https://hophuloc.online
# VITE_API_URL=https://hophuloc.online
# DATABASE_URL="postgresql://postgres:<YOUR_SECURE_POSTGRES_PASSWORD>@127.0.0.1:5432/hophuloc_expense_db?schema=public"

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION (Mandatory)
# ------------------------------------------------------------------------------
# In development, you can use these default dev secrets:
JWT_SECRET="dev_jwt_secret_must_be_minimum_32_characters_long_for_security_12345"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_must_be_minimum_32_characters_long_12345"

# ------------------------------------------------------------------------------
# 4. THIRD-PARTY INTEGRATIONS (Optional)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 (For Google Sign-In)
# Frontend Client ID (safe for browser)
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# Backend Client Secret (Private - NEVER expose to frontend or commit to git)
GOOGLE_CLIENT_SECRET=""

# Gemini AI Assistant (For natural language transaction parsing & financial advice)
GEMINI_API_KEY=""

# Logging Level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
