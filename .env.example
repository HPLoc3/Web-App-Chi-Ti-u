# Application Environment
NODE_ENV=production
APP_URL=https://hophuloc.online
ALLOWED_ORIGINS="https://hophuloc.online,https://www.hophuloc.online,http://localhost:5173,http://localhost:3000"

# API Base URL configuration
VITE_API_URL=https://hophuloc.online

# Database URL for PostgreSQL (Single Source of Truth)
# - For Docker Compose on VPS (app and postgres in same network): use host "postgres"
DATABASE_URL="postgresql://postgres:<YOUR_SECURE_POSTGRES_PASSWORD>@postgres:5432/hophuloc_expense_db?schema=public"
# - For Local standalone development (outside Docker): use host "localhost"
# DATABASE_URL="postgresql://postgres:<YOUR_SECURE_POSTGRES_PASSWORD>@localhost:5432/hophuloc_expense_db?schema=public"

# Database Credentials for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_SECURE_POSTGRES_PASSWORD>
POSTGRES_DB=hophuloc_expense_db

# JWT Secrets (Mandatory - Use long secure random strings in production, min 32 characters)
JWT_SECRET="<GENERATE_RANDOM_LONG_SECRET_MIN_32_CHARS>"
JWT_REFRESH_SECRET="<GENERATE_RANDOM_LONG_REFRESH_SECRET_MIN_32_CHARS>"

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID="<your_google_client_id>.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="<your_google_client_id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<your_google_client_secret>"

# Gemini API Key (Optional for AI Assistant features)
GEMINI_API_KEY="<your_gemini_api_key>"
