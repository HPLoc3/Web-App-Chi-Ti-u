# ==========================================
# Application Environment & Network Settings
# ==========================================
NODE_ENV=production
PORT=3000
APP_URL=https://hophuloc.online
ALLOWED_ORIGINS="https://hophuloc.online,https://www.hophuloc.online,http://localhost:5173,http://localhost:3000"

# Frontend API URL
VITE_API_URL=https://hophuloc.online

# ==========================================
# Database Configuration (PostgreSQL 16)
# ==========================================
# Credentials used by PostgreSQL container & backups:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_SECURE_POSTGRES_PASSWORD>
POSTGRES_DB=hophuloc_expense_db

# --- DEPLOYMENT MODE A: PM2 on VPS Host (Connect to exposed port on loopback 127.0.0.1) ---
# Use this when running Node directly with PM2 (e.g. pm2 start ecosystem.config.cjs):
DATABASE_URL="postgresql://postgres:<YOUR_SECURE_POSTGRES_PASSWORD>@127.0.0.1:5432/hophuloc_expense_db?schema=public"

# --- DEPLOYMENT MODE B: Docker Compose App Container (Optional override) ---
# If running the app container inside Docker Compose, it defaults to using host "postgres".
# You can optionally define DATABASE_URL_DOCKER if your password contains special URL characters:
# DATABASE_URL_DOCKER="postgresql://postgres:<YOUR_URL_ENCODED_PASSWORD>@postgres:5432/hophuloc_expense_db?schema=public"

# ==========================================
# Security & JWT Authentication (Mandatory)
# ==========================================
# Must be long secure random strings (minimum 32 characters in production)
JWT_SECRET="<GENERATE_RANDOM_LONG_SECRET_MIN_32_CHARS>"
JWT_REFRESH_SECRET="<GENERATE_RANDOM_LONG_REFRESH_SECRET_MIN_32_CHARS>"

# ==========================================
# Third-Party Integrations (Optional)
# ==========================================
# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID="<your_google_client_id>.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="<your_google_client_id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<your_google_client_secret>"

# Gemini AI Assistant (Optional)
GEMINI_API_KEY="<your_gemini_api_key>"
