# Application Environment
NODE_ENV=production
APP_URL=https://hophuloc.online
ALLOWED_ORIGINS="https://hophuloc.online,https://www.hophuloc.online,http://localhost:5173,http://localhost:3000"

# API Base URL configuration
VITE_API_URL=https://hophuloc.online

# Database URL for PostgreSQL (Single Source of Truth)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/hophuloc_expense_db?schema=public"

# Database Credentials for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=hophuloc_expense_db

# JWT Secrets (Mandatory - Use long secure random strings in production)
JWT_SECRET="staychitiu-super-secure-access-token-jwt-secret-key-2026"
JWT_REFRESH_SECRET="staychitiu-super-secure-refresh-token-jwt-secret-key-2026"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Gemini API Key (Optional for AI Assistant feature)
GEMINI_API_KEY="your_gemini_api_key_here"
